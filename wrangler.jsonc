{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastspam",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // No public URL: this Worker only runs on a schedule.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Every 15 minutes. Each run sends the digest if one is due (DIGEST_DAYS
    // and DIGEST_HOUR below) and otherwise does one small slice of work, which
    // keeps every run inside the Workers Free CPU limit (README "Schedule").
    // CRON in .dev.vars replaces this for npm run deploy.
    "crons": ["*/15 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    // Dashboard name: "fastspam-state" (Storage & Databases → KV).
    // Holds progress through Sent and Spam, finds waiting for the digest, and
    // the Sent-recipient index. Safe to delete: the index is rebuilt and Spam
    // is reviewed again from the start, so finds may be reported twice.
    // No id: `wrangler deploy` creates the namespace on first deploy and reuses
    // it after that, so nothing account-specific is committed. (An id is not a
    // secret, but leaving it out keeps forks deployable as-is.)
    { "binding": "FASTSPAM_STATE" }
  ],
  "send_email": [
    // Only used when NOTIFIER is "cloudflare". No destination pinned here so no
    // address is committed; the recipient must be a verified Email Routing
    // destination address.
    { "name": "EMAIL" }
  ],
  "vars": {
    "DRY_RUN": "false",
    // "fastmail" (needs FASTMAIL_WRITE_TOKEN), "postmark" or "cloudflare"
    "NOTIFIER": "fastmail",
    // IANA timezone for the digest time and the dates in it
    "TIMEZONE": "UTC",
    // When the digest goes out, in TIMEZONE: weekdays ("mon", "mon,thu" or
    // "daily") at this hour (0-23).
    "DIGEST_DAYS": "mon",
    "DIGEST_HOUR": "20",

    // Decision model. Clef models run on the free Workers AI allocation; the
    // google/ and openai/ models need AI_GATEWAY_ID and AI Gateway credits.
    "AI_MODEL": "@cf/cloudflare/clef",
    // "categories" (six-way) or "yesno" (one yes/no question per message)
    "QUESTION_STYLE": "categories",
    "AI_GATEWAY_ID": "",
    // Report a model verdict when P(not spam) is at least this.
    "SPAM_REVIEW_THRESHOLD": "0.6",
    // Drop mail that fails DMARC when the sender's domain says p=quarantine/reject.
    "HONOUR_DMARC_POLICY": "true",
    "BATCH_SIZE": "16",
    "MAX_MODEL_CALLS_PER_RUN": "16",
    // Characters of message body sent to the model; 0 = never fetch the body.
    "PREVIEW_CHARS": "200",

    // Work per run: Spam messages reviewed, or Sent messages indexed. Sized
    // for the Workers Free 10 ms CPU limit; MAX_SLICES_PER_RUN > 1 does more
    // per run on Workers Paid.
    "SPAM_SLICE": "40",
    "SENT_PAGE": "200",
    "MAX_SLICES_PER_RUN": "1",
    // How far back the first pass through Spam starts. Empty = all of it.
    "BACKLOG_DAYS": "",
    // Sender patterns: address, domain, or *@domain (README "Rules").
    "TRUSTED_SENDERS": "",
    "SPAM_SENDERS": "",
    // Leave empty until the preview shows what scores your spam carries.
    "SPAM_SCORE_SKIP_ABOVE": "",
    // The score at which Fastmail moves mail to Spam (Standard 5, Aggressive
    // 4, or your Custom value). Spam scoring lower is mail you moved there:
    // never reported, and its senders are learned. 0 = off.
    "SPAM_FILTER_THRESHOLD": "5",
    "LEARN_SPAM_SENDERS": "true",
    // Never report Spam you've read and left there. Off by default: some mail
    // apps mark messages read just by previewing them.
    "SPAM_SKIP_READ": "false",

    // Optional: move fact-based suspects out of Spam into this mailbox.
    // Needs FASTMAIL_WRITE_TOKEN. Empty = report only, never touch mail.
    "RESCUE_MAILBOX": "",
    "RESCUE_BASIS": "deterministic",
    "MAX_RESCUES_PER_DIGEST": "20",

    // Also check these folders for spam, scams and phishing the filter let
    // through, and report finds at most every INCOMING_REPORT_MINUTES (15 minutes
    // once something has been quarantined).
    // Empty = off (README "Checking incoming mail").
    "INCOMING_MAILBOXES": "",
    "INCOMING_SKIP_READ": "false",
    "INCOMING_THRESHOLD": "0.7",
    "INCOMING_REPORT_MINUTES": "60",
    // Optional: move the clearest finds into this folder. Needs
    // FASTMAIL_WRITE_TOKEN. Empty = report only (README "Quarantine").
    "QUARANTINE_MAILBOX": "",
    "QUARANTINE_THRESHOLD": "0.9",
    "MAX_QUARANTINE_PER_DAY": "20",

    // NOTIFIER=fastmail only: the folder digests, reports and alerts are filed
    // in (name or path). Empty = the Inbox. Fastmail rules don't run on them.
    "DIGEST_MAILBOX": "",
    // The Fastmail web app that digest links open in, e.g. https://app.beta.fastmail.com.
    "FASTMAIL_URL": "https://app.fastmail.com",
    "SEND_WHEN_EMPTY": "true",
    // Workers Free allows 50 subrequests per run; raise on Workers Paid.
    "SUBREQUEST_BUDGET": "45"
  },
  "observability": { "enabled": true }
  // Secrets (never in this file):
  //   FASTMAIL_TOKEN         Fastmail API token, Read-only access
  //   FASTMAIL_WRITE_TOKEN   optional; Email scope, for NOTIFIER=fastmail, RESCUE_MAILBOX or QUARANTINE_MAILBOX
  //   POSTMARK_SERVER_TOKEN  optional; NOTIFIER=postmark
  //   EMAIL_FROM / EMAIL_TO  digest addresses (see README)
}
